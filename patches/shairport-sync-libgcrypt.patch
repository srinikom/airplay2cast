+#ifdef CONFIG_LIBGCRYPT
+// AES-128-CBC without padding; len must be a multiple of 16
+static int gcrypt_aes_decrypt_cbc(unsigned char *ciphertext, int ciphertext_len,
+                                  unsigned char *key, unsigned char *iv,
+                                  unsigned char *plaintext) {
+  gcry_cipher_hd_t h;
+  int rc = -1;
+  if (gcry_cipher_open(&h, GCRY_CIPHER_AES128, GCRY_CIPHER_MODE_CBC, 0) == 0) {
+    if (gcry_cipher_setkey(h, key, 16) == 0 && gcry_cipher_setiv(h, iv, 16) == 0 &&
+        gcry_cipher_decrypt(h, plaintext, ciphertext_len, ciphertext, ciphertext_len) == 0)
+      rc = ciphertext_len;
+    gcry_cipher_close(h);
+  }
+  if (rc < 0)
+    debug(1, "AES decryption failed.");
+  return rc;
+}
+#endif
+
