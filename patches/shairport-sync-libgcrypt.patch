diff --git a/common.c b/common.c
index cdf66b9..ef9a824 100644
--- a/common.c
+++ b/common.c
@@ -83,6 +83,10 @@
 #include <openssl/rsa.h> // needed for EVP_PKEY_CTX_set_rsa_padding
 #endif
 
+#ifdef CONFIG_LIBGCRYPT
+#include <gcrypt.h>
+#endif
+
 #ifdef CONFIG_POLARSSL
 #include "polarssl/ctr_drbg.h"
 #include "polarssl/entropy.h"
@@ -780,6 +784,57 @@ uint8_t *base64_dec(char *input, int *outlen) {
 }
 #endif
 
+#ifdef CONFIG_LIBGCRYPT
+static int base64_value(char c) {
+  if (c >= 'A' && c <= 'Z')
+    return c - 'A';
+  if (c >= 'a' && c <= 'z')
+    return c - 'a' + 26;
+  if (c >= '0' && c <= '9')
+    return c - '0' + 52;
+  if (c == '+')
+    return 62;
+  if (c == '/')
+    return 63;
+  return -1;
+}
+
+// returns a NUL-terminated encoding without line breaks
+char *base64_enc(uint8_t *input, int length) {
+  size_t olen = 4 * (((size_t)length + 2) / 3);
+  char *buf = malloc(olen + 1);
+  if (buf == NULL)
+    die("could not allocate memory for buf in base64_enc");
+  if (base64_encode_so(input, length, buf, &olen) == NULL)
+    olen = 0;
+  buf[olen] = 0;
+  return buf;
+}
+
+// accepts input with or without padding (Apple omits it) and ignores whitespace
+uint8_t *base64_dec(char *input, int *outlen) {
+  size_t inlen = strlen(input);
+  uint8_t *buf = malloc(inlen * 3 / 4 + 3);
+  if (buf == NULL)
+    die("could not allocate memory for buf in base64_dec");
+  uint32_t acc = 0;
+  int bits = 0, n = 0;
+  for (size_t i = 0; i < inlen && input[i] != '='; i++) {
+    int v = base64_value(input[i]);
+    if (v < 0)
+      continue;
+    acc = (acc << 6) | (uint32_t)v;
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      buf[n++] = (uint8_t)(acc >> bits);
+    }
+  }
+  *outlen = n;
+  return buf;
+}
+#endif
+
 static char super_secret_key[] =
     "-----BEGIN RSA PRIVATE KEY-----\n"
     "MIIEpQIBAAKCAQEA59dE8qLieItsH1WgjrcFRKj6eUWqi+bGLOX1HL3U3GhC/j0Qg90u3sG/1CUt\n"
@@ -890,6 +945,135 @@ uint8_t *rsa_apply(uint8_t *input, int inlen, int *outlen, int mode) {
 }
 #endif
 
+#ifdef CONFIG_LIBGCRYPT
+// reads one DER element with the given tag; returns 0 and advances *p on success
+static int der_element(const uint8_t **p, const uint8_t *end, uint8_t tag, const uint8_t **val,
+                       size_t *len) {
+  const uint8_t *q = *p;
+  if (end - q < 2 || *q++ != tag)
+    return -1;
+  size_t l = *q++;
+  if (l & 0x80) {
+    int nb = l & 0x7f;
+    if (nb < 1 || nb > 4 || end - q < nb)
+      return -1;
+    for (l = 0; nb--;)
+      l = (l << 8) | *q++;
+  }
+  if ((size_t)(end - q) < l)
+    return -1;
+  *val = q;
+  *len = l;
+  *p = q + l;
+  return 0;
+}
+
+// builds a libgcrypt private key from the PEM-encoded PKCS#1 RSAPrivateKey above
+static gcry_sexp_t rsa_private_key(void) {
+  const char *b = strstr(super_secret_key, "-----\n");
+  const char *e = strstr(super_secret_key, "\n-----END");
+  if (b == NULL || e == NULL || e <= b)
+    return NULL;
+  char *pem = strndup(b + 6, e - (b + 6));
+  int derlen = 0;
+  uint8_t *der = base64_dec(pem, &derlen);
+  free(pem);
+
+  gcry_sexp_t key = NULL;
+  gcry_mpi_t m[9] = {NULL}; // version, n, e, d, p, q, dp, dq, qinv
+  const uint8_t *p = der, *end = der + derlen, *val;
+  size_t len;
+  int i, ok = der_element(&p, end, 0x30, &val, &len) == 0;
+  if (ok) {
+    p = val;
+    end = val + len;
+  }
+  for (i = 0; ok && i < 9; i++)
+    ok = der_element(&p, end, 0x02, &val, &len) == 0 &&
+         gcry_mpi_scan(&m[i], GCRYMPI_FMT_USG, val, len, NULL) == 0;
+  if (ok) {
+    // libgcrypt requires p < q and u = p^-1 mod q
+    gcry_mpi_t kp = m[4], kq = m[5];
+    if (gcry_mpi_cmp(kp, kq) > 0) {
+      kp = m[5];
+      kq = m[4];
+    }
+    gcry_mpi_t u = gcry_mpi_new(0);
+    gcry_mpi_invm(u, kp, kq);
+    if (gcry_sexp_build(&key, NULL, "(private-key(rsa(n%m)(e%m)(d%m)(p%m)(q%m)(u%m)))", m[1],
+                        m[2], m[3], kp, kq, u) != 0)
+      key = NULL;
+    gcry_mpi_release(u);
+  } else {
+    debug(1, "can not parse the RSA private key");
+  }
+  for (i = 0; i < 9; i++)
+    gcry_mpi_release(m[i]);
+  free(der);
+  return key;
+}
+
+uint8_t *rsa_apply(uint8_t *input, int inlen, int *outlen, int mode) {
+  uint8_t *out = NULL;
+  *outlen = 0;
+  gcry_sexp_t key = rsa_private_key();
+  if (key == NULL)
+    return NULL;
+  size_t keylen = (gcry_pk_get_nbits(key) + 7) / 8;
+  gcry_sexp_t data = NULL, result = NULL, token = NULL;
+  gcry_error_t rc;
+
+  switch (mode) {
+  case RSA_MODE_AUTH: // a PKCS#1 v1.5 signature of the raw input, without a DigestInfo
+    rc = gcry_sexp_build(&data, NULL, "(data(flags pkcs1-raw)(value %b))", inlen, input);
+    if (rc == 0)
+      rc = gcry_pk_sign(&result, data, key);
+    if (rc == 0 && (token = gcry_sexp_find_token(result, "s", 0)) != NULL) {
+      gcry_mpi_t s = gcry_sexp_nth_mpi(token, 1, GCRYMPI_FMT_USG);
+      size_t slen = 0;
+      out = calloc(1, keylen);
+      // left-pad the signature to the key length
+      if (s != NULL && out != NULL &&
+          gcry_mpi_print(GCRYMPI_FMT_USG, NULL, 0, &slen, s) == 0 && slen <= keylen &&
+          gcry_mpi_print(GCRYMPI_FMT_USG, out + keylen - slen, slen, NULL, s) == 0)
+        *outlen = keylen;
+      gcry_mpi_release(s);
+    }
+    if (rc != 0)
+      debug(1, "RSA sign error: %s", gcry_strerror(rc));
+    break;
+  case RSA_MODE_KEY:
+    rc = gcry_sexp_build(&data, NULL, "(enc-val(flags oaep)(hash-algo sha1)(rsa(a %b)))", inlen,
+                         input);
+    if (rc == 0)
+      rc = gcry_pk_decrypt(&result, data, key);
+    if (rc == 0 && (token = gcry_sexp_find_token(result, "value", 0)) != NULL) {
+      size_t vlen = 0;
+      const char *v = gcry_sexp_nth_data(token, 1, &vlen);
+      if (v != NULL && (out = malloc(vlen ? vlen : 1)) != NULL) {
+        memcpy(out, v, vlen);
+        *outlen = vlen;
+      }
+    }
+    if (rc != 0)
+      debug(1, "RSA decrypt error: %s", gcry_strerror(rc));
+    break;
+  default:
+    debug(1, "Unknown mode");
+    break;
+  }
+  if (*outlen == 0) {
+    free(out);
+    out = NULL;
+  }
+  gcry_sexp_release(token);
+  gcry_sexp_release(result);
+  gcry_sexp_release(data);
+  gcry_sexp_release(key);
+  return out;
+}
+#endif
+
