--- a/configure.ac
+++ b/configure.ac
@@ -513,15 +513,6 @@
     )]
   )
   PKG_CHECK_MODULES(
-    [libavformat], [libavformat],
-    [CFLAGS="${libavformat_CFLAGS} ${CFLAGS}" LIBS="${libavformat_LIBS} ${LIBS}"],
-    [AC_CHECK_LIB(
-      [avformat], [avformat_new_stream],
-      [],
-      [AC_MSG_ERROR([FFmpeg requires libavformat -- libavformat-dev suggested])]
-    )]
-  )
-  PKG_CHECK_MODULES(
     [libswresample], [libswresample],
     [CFLAGS="${libswresample_CFLAGS} ${CFLAGS}" LIBS="${libswresample_LIBS} ${LIBS}"],
     [AC_CHECK_LIB(
